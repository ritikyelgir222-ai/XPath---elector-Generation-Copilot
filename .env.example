# Optional. Without a key the app uses the built-in offline DOM engine (fully functional).
# With a key, Gemini is tried first and its XPath is verified against your HTML before it is shown.
#   - Google AI Studio keys (start with "AIza...")  -> Gemini Developer API
#   - Vertex AI express-mode keys (start with "AQ.") -> Vertex AI (detected automatically)
GEMINI_API_KEY=""

# Optional overrides
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_TIMEOUT_MS=20000
# PORT=3000
